# 本文件是 .env 的安全模板，只写占位值和参数作用。
# 真正运行时请复制到 .env 后填写真实参数；不要把 .env 提交或贴给别人。

# ===== AGICTO / OpenAI 兼容模型 =====

# 必填。AGICTO API Key，用于 ChatOpenAI 和 OpenAIEmbeddings。
AGICTO_API_KEY=

# 必填。AGICTO OpenAI 兼容接口地址，默认值通常是 https://api.agicto.cn/v1。
AGICTO_BASE_URL=https://api.agicto.cn/v1

# 可选。主对话模型名称，例如 gpt-5.4。
AGICTO_MODEL=gpt-5.4

# ===== 会话身份 =====

# 可选。当前会话线程 ID，用于 LangGraph checkpointer 和记忆隔离。
THREAD_ID=default

# 可选。当前用户 ID，用于按用户读取和写入长期记忆。
USER_ID=default_user

# 可选。租户 ID，用于多租户场景下隔离记忆数据。
TENANT_ID=default_tenant

# 可选。工作流最大迭代次数，用于限制多智能体流程循环。
MAX_ITERATIONS=3

# ===== 记忆与持久化 =====

# 可选。是否启用外部记忆系统；本地快速试跑可设为 false。
ENABLE_MEMORY=true

# 可选。短期记忆保留秒数，默认 604800 秒，即 7 天。
SHORT_TERM_TTL_SECONDS=604800

# 可选。短期记忆最多保留的消息数。
SHORT_TERM_MAX_MESSAGES=30

# 可选。短期消息超过该阈值后触发摘要压缩。
SHORT_TERM_SUMMARY_THRESHOLD=20

# 可选。短期记忆后端，可用 postgres、redis、memory。
SHORT_TERM_BACKEND=postgres

# 可选。长期记忆后端，可用 postgres、sqlite、disabled。
LONG_TERM_BACKEND=postgres

# 可选。长期记忆作用域，可用 user 或 thread。
LONG_TERM_SCOPE=user

# 可选。是否把保存对话记忆作为后台任务处理。
SAVE_CONVERSATION_TASK=false

# 可选。LangGraph checkpointer 后端，可用 postgres、redis、memory、auto。
CHECKPOINTER_BACKEND=auto

# ===== 向量检索 =====

# 可选。是否启用 Milvus 向量库；没有本地/远程 Milvus 时可设为 false。
ENABLE_MILVUS=true

# 可选。读取个性化记忆或检索结果时返回的条数。
MEMORY_TOP_K=6

# 可选。Redis 连接串；当短期记忆或 checkpointer 使用 redis 时填写。
REDIS_URL=

# 可选。PostgreSQL 连接串；当记忆或 checkpointer 使用 postgres 时填写。
POSTGRES_DSN=

# 可选。Milvus 主机地址；启用 Milvus 时填写。
MILVUS_HOST=

# 可选。Milvus 端口。
MILVUS_PORT=19530

# 可选。Milvus collection 名称，用于存储向量记忆。
MILVUS_COLLECTION=mult_agent_memory

# ===== 本地运行体验 =====

# 可选。设为 1 或 true 可关闭终端彩色输出。
NO_COLOR=

# 可选。工具读写文件的工作目录。
WORKSPACE_DIR=/workspace
